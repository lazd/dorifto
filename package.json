{
  "name": "dorifto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "test": "node --test tests/*.test.mjs",
    "build": "tsc --noEmit && vite build",
    "deploy": "npm run build && gh-pages --dist dist --remote origin --branch gh-pages --nojekyll",
    "preview": "vite preview --open",
    "import-track": "node scripts/import-track.mjs",
    "import-road": "node scripts/import-road.mjs",
    "train:bot": "node scripts/optimize-race-bot.mjs --preset grip-default --generations 30",
    "train:bot:resume": "npm run train:bot -- --resume",
    "train:drift": "node scripts/optimize-drift-bot.mjs --preset drift-default --generations 20",
    "evaluate:bot": "node scripts/evaluate-bot.mjs",
    "apply:bot": "node scripts/apply-bot-tuning.mjs",
    "learn:bot": "node scripts/learn-from-lap.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "ammojs-typed": "^1.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "geotiff": "^2.1.3",
    "gh-pages": "~6.1.1",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{css,html,json,md}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
